# Environment & Secrets (Never commit actual credentials)
.env
.env.local
.env.*.local
*.env
!.env.example
*.bin
*.key
*.pem
*.enc

# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual environment
venv/
env/
ENV/

# Local databases & runtime storage
*.db
*.db-journal
*.sqlite
*.sqlite3
auth.db
auth.db-journal
tasks.db
tasks.db-journal
chroma_db/
.chroma/
backend/data/
data/
uploaded_docs/
multimodal_uploads/
generated_artifacts/
audit_trail.jsonl
.public_share_url

# Logs & temp files
*.log
*.zip
scratch/
.DS_Store
Thumbs.db
.idea/
.vscode/
