# ==============================================================================
# Sovereign AI Workbench - Environment Configuration Template (SIH26117)
# Supports both On-Premise Air-Gapped Operation and Cloud Web Service Deployment
# ==============================================================================

# Operating Environment
# 'production-airgapped' (default local), 'production-cloud', or 'development'
ENVIRONMENT=production-airgapped

# Air-gap strict enforcement (Set 'false' for Cloud Demo Mode or remote Ollama instances)
AIR_GAP_STRICT_MODE=true

# Server Network Binding (127.0.0.1 for local dev, 0.0.0.0 for Docker/Cloud containers)
HOST=127.0.0.1
PORT=8000

# Optional persistent storage mount path (e.g., Render Persistent Disk '/var/data')
# If blank, defaults to local project directory
DATA_DIR=

# Allowed CORS Origins (comma-separated for external frontend clients)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI Inference Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.1
EMBEDDING_MODEL_NAME=nomic-embed-text

# Session Security & Cryptographic Token Verification
# In production, replace with a random 256-bit hexadecimal or base64 secret string
AUTH_SECRET_KEY=sovereign-ai-workbench-airgapped-auth-secret-key-sih2026
SESSION_EXPIRE_HOURS=12

# Default Administrator Bootstrap Credentials (Initialized on first run)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=SovereignAdmin2026!
ADMIN_DEFAULT_EMAIL=admin@sovereign.local
ADMIN_DEFAULT_FULL_NAME=Sovereign Administrator

# ==============================================================================
# Social Authentication (Optional - Leave blank to disable external providers)
# ==============================================================================

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback
