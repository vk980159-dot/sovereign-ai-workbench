# ==============================================================================
# Sovereign AI Workbench - Environment Configuration Template (SIH26117)
# 100% On-Premise Air-Gapped Operation with Optional Social Authentication
# ==============================================================================

# Local Network Binding
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8000

# Local AI Engine (Ollama)
WORKBENCH_OLLAMA_BASE_URL=http://localhost:11434
WORKBENCH_DEFAULT_MODEL=llama3.1:latest
WORKBENCH_EMBEDDING_MODEL_NAME=nomic-embed-text:latest

# Security & Session Authentication
WORKBENCH_AUTH_SECRET_KEY=sovereign-ai-workbench-airgapped-auth-secret-key-sih2026
WORKBENCH_SESSION_EXPIRE_HOURS=12

# Default Offline Administrator Bootstrap (First Run)
WORKBENCH_ADMIN_DEFAULT_USERNAME=admin
WORKBENCH_ADMIN_DEFAULT_PASSWORD=SovereignAdmin2026!
WORKBENCH_ADMIN_DEFAULT_EMAIL=admin@sovereign.local
WORKBENCH_ADMIN_DEFAULT_FULL_NAME=Sovereign Administrator

# ==============================================================================
# Social Authentication (Optional - Leave blank for 100% air-gapped standalone)
# ==============================================================================

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback
